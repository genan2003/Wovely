# Copy to .env (gitignored) and fill in. docker compose reads it automatically.
# For local `mvn spring-boot:run`, export the same variables in your shell.

# HS256 signing key shared by all services — Base64, at least 256 bit.
# Generate:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Shared key for service-to-service calls on /internal/** (X-Internal-Api-Key header).
# Generate:  openssl rand -hex 32
INTERNAL_API_KEY=

# "dev" seeds demo users admin/admin123, seller/seller123, testuser/user123. Use "prod" to disable.
SPRING_PROFILES_ACTIVE=dev

CORS_ALLOWED_ORIGINS=http://localhost:4200

# RabbitMQ (stock events, PLAN.md 4.2) — any strong password; user defaults to "wovely"
RABBITMQ_USER=wovely
RABBITMQ_PASSWORD=

# Optional: gateway port on the host (default 8090)
# GATEWAY_PORT=8090
