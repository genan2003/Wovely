{
    "components": {
        "schemas": {
            "InitRequest": {
                "properties": {
                    "category": {
                        "type": "string"
                    },
                    "co2EmissionScore": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": "string"
                    },
                    "initialQuantity": {
                        "format": "int32",
                        "minimum": 0,
                        "type": "integer"
                    },
                    "isHandmade": {
                        "type": "boolean"
                    },
                    "lowStockThreshold": {
                        "format": "int32",
                        "minimum": 0,
                        "type": "integer"
                    },
                    "priceCents": {
                        "format": "int64",
                        "minimum": 0,
                        "type": "integer"
                    },
                    "productName": {
                        "type": "string"
                    },
                    "sellerId": {
                        "minLength": 1,
                        "type": "string"
                    },
                    "shippingMethod": {
                        "type": "string"
                    }
                },
                "required": [
                    "initialQuantity",
                    "sellerId"
                ],
                "type": "object"
            },
            "QuantityRequest": {
                "properties": {
                    "quantity": {
                        "format": "int32",
                        "type": "integer"
                    },
                    "sellerId": {
                        "minLength": 1,
                        "type": "string"
                    }
                },
                "required": [
                    "quantity",
                    "sellerId"
                ],
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerJwt": {
                "bearerFormat": "JWT",
                "description": "Access token from POST /api/auth/signin (15 min)",
                "scheme": "bearer",
                "type": "http"
            },
            "internalApiKey": {
                "description": "Service-to-service calls on /internal/** only",
                "in": "header",
                "name": "X-Internal-Api-Key",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "description": "Handmade-goods marketplace. Errors use {status, error, message, path, timestamp}; /internal/** endpoints are service-to-service only and are not reachable through the gateway.",
        "title": "Wovely \u2013 inventory API",
        "version": "v1"
    },
