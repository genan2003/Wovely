{
    "components": {
        "schemas": {
            "Category": {
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "level": {
                        "format": "int32",
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "parentId": {
                        "type": "string"
                    },
                    "slug": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Product": {
                "properties": {
                    "category": {
                        "type": "string"
                    },
                    "categoryPath": {
                        "type": "string"
                    },
                    "city": {
                        "type": "string"
                    },
                    "co2EmissionScore": {
                        "type": "string"
                    },
                    "deliveryEmission": {
                        "enum": [
                            "ZERO",
                            "LOW",
                            "STANDARD"
                        ],
                        "readOnly": true,
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "handmade": {
                        "type": "boolean"
                    },
                    "id": {
                        "type": "string"
                    },
                    "imageUrl": {
                        "type": "string"
                    },
                    "latitude": {
                        "format": "double",
                        "type": "number"
                    },
                    "localPickup": {
                        "type": "boolean"
                    },
                    "longitude": {
                        "format": "double",
                        "type": "number"
                    },
                    "lowStock": {
                        "type": "boolean"
                    },
                    "lowStockThreshold": {
                        "format": "int32",
                        "type": "integer"
                    },
                    "materials": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "name": {
                        "type": "string"
                    },
                    "outOfStock": {
                        "type": "boolean"
                    },
                    "price": {
                        "format": "double",
                        "type": "number"
                    },
                    "region": {
                        "type": "string"
                    },
                    "sellerId": {
                        "type": "string"
                    },
                    "shippingMethod": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "stockQuantity": {
                        "format": "int32",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "Review": {
                "properties": {
                    "comment": {
                        "type": "string"
                    },
                    "createdAt": {
                        "format": "date-time",
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "photoUrls": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array"
                    },
                    "productId": {
                        "type": "string"
                    },
                    "rating": {
                        "format": "int32",
                        "type": "integer"
                    },
                    "userId": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    },
                    "verifiedPurchase": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerJwt": {
                "bearerFormat": "JWT",
                "description": "Access token from POST /api/auth/signin (15 min)",
                "scheme": "bearer",
                "type": "http"
            },
            "internalApiKey": {
                "description": "Service-to-service calls on /internal/** only",
                "in": "header",
                "name": "X-Internal-Api-Key",
                "type": "apiKey"
            }
        }
    },
    "info": {
        "description": "Handmade-goods marketplace. Errors use {status, error, message, path, timestamp}; /internal/** endpoints are service-to-service only and are not reachable through the gateway.",
