' Shared styling for all Wovely diagrams — include with  !include ../_theme.puml
' Kept deliberately neutral; colour is used only to carry meaning:
'   #E8F1E4 (moss tint)  = box: service boundary that enforces JWT/ownership
'   #FAF6EF (linen)      = box: core service
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam ArrowColor #4A4A4A
skinparam sequence {
  ParticipantBorderColor #6B5B4B
  ParticipantBackgroundColor #FAF6EF
  LifeLineBorderColor #B8AC9C
  ActorBorderColor #6B5B4B
  ActorBackgroundColor #FAF6EF
  GroupBorderColor #9C8B78
  BoxBorderColor #B8AC9C
}
skinparam state {
  BackgroundColor #FAF6EF
  BorderColor #6B5B4B
  ArrowColor #4A4A4A
  StartColor #6B5B4B
  EndColor #6B5B4B
}
skinparam database {
  BorderColor #6B5B4B
  BackgroundColor #FAF6EF
}
skinparam note {
  BorderColor #B8AC9C
  BackgroundColor #FFFDF8
}
skinparam class {
  BackgroundColor #FAF6EF
  BorderColor #6B5B4B
  ArrowColor #4A4A4A
  HeaderBackgroundColor #F1EADF
}
skinparam stereotypeCBackgroundColor #E8F1E4
skinparam stereotypeEBackgroundColor #F1EADF
skinparam usecase {
  BackgroundColor #FAF6EF
  BorderColor #6B5B4B
  ArrowColor #4A4A4A
}
skinparam actor {
  BackgroundColor #FAF6EF
  BorderColor #6B5B4B
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #9C8B78
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #9C8B78
}
skinparam activity {
  BackgroundColor #FAF6EF
  BorderColor #6B5B4B
  DiamondBackgroundColor #F1EADF
  DiamondBorderColor #6B5B4B
  StartColor #6B5B4B
  EndColor #6B5B4B
  BarColor #6B5B4B
}
skinparam swimlane {
  BorderColor #9C8B78
  TitleFontStyle bold
}
