  "item": [
    {
      "name": "Sign in as seller",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrlCore}}/api/auth/signin",
        "description": "",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"seller\",\n  \"password\": \"seller123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test(\"returns a bearer token, id and roles\", () => {",
              "  pm.expect(body.accessToken).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(body.tokenType).to.eql(\"Bearer\");",
              "  pm.expect(body.id).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(body.roles).to.be.an(\"array\").that.is.not.empty;",
              "});",
              "pm.collectionVariables.set(\"sellerToken\", body.accessToken);",
              "pm.collectionVariables.set(\"sellerId\", body.id);"
            ]
          }
        }
      ]
    },
